NODE_ENV=development
DATABASE_URL=postgresql://pos:pos@localhost:5432/pos
API_PORT=3001
WEB_PORT=3000
WEB_URL=http://localhost:3000
# Browser API origin. Keep this on the web origin when using the same-origin
# /api proxy shape (the default local and Render configuration).
NEXT_PUBLIC_API_BASE=http://localhost:3000
# Optional server-side Next.js /api proxy target. Accepts either a full
# http(s) URL or a private-network host:port such as service-name:10000.
API_PROXY_TARGET=http://localhost:3001

# Transactional email. Production requires exactly one delivery transport.
# Preferred on hosts that block SMTP (including Railway Free/Hobby):
BREVO_API_KEY=
# SMTP alternative for hosts that allow outbound SMTP:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM="NexPOS <noreply@example.com>"

# PayMongo Hosted Checkout (Card / GCash / Maya / QR Ph).
# Use sk_test_* locally, then rotate to sk_live_* only after sandbox/UAT passes.
PAYMONGO_SECRET_KEY=
# Secret shown when creating the PayMongo webhook endpoint.
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_BASE=https://api.paymongo.com
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

# "1" gates login until the emailed verification link is redeemed.
AUTH_REQUIRE_EMAIL_VERIFICATION=
# Maximum registration attempts accepted per source IP per minute.
REGISTRATION_RATE_LIMIT=10
# Maximum login attempts accepted per source IP per minute. Every attempt
# counts, including successful ones. Leave unset in production (5/min default);
# local dev and the e2e suite raise it because one loopback IP serves many
# disposable accounts.
LOGIN_RATE_LIMIT=

# Billing/subscription plans are disabled by default. Set to 1 only if the
# SaaS billing/plan system is intentionally enabled.
BILLING_ENABLED=0

# Platform routes (/api/v1/platform/*) stay closed while unset.
PLATFORM_API_KEY=
# Bearer token for /api/v1/metrics; unset keeps the endpoint closed.
METRICS_TOKEN=
# Postgres pool size (default 30).
PG_POOL_MAX=30
# HMAC secret per billing provider, e.g. BILLING_TEST_DOUBLE_SECRET.
BILLING_<PROVIDER>_SECRET=
