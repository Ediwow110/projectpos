{
  "name": "online-pos",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev-local.mjs",
    "dev:memory": "turbo run dev",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"tests/**/*.ts\" playwright.config.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:exit": "vitest run --root . tests/",
    "verify": "node scripts/verify-scaffold.test.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "turbo": "^2.11.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.4.0",
      "postcss": "8.5.23"
    }
  }
}
