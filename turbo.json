{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  },
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "NEXT_PUBLIC_API_BASE",
    "API_PROXY_TARGET",
    "WEB_URL",
    "API_PORT",
    "REGISTRATION_RATE_LIMIT",
    "LOGIN_RATE_LIMIT"
  ]
}
