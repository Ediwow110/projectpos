{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "permission": {
    "*": "allow",
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "skill": "allow",
    "task": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "external_directory": "allow"
  },
  "tools": {
    "bash": true,
    "read": true,
    "edit": true,
    "write": true,
    "task": true,
    "skill": true,
    "todowrite": true,
    "grep": true,
    "glob": true,
    "webfetch": true
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@upstash/context7-opencode"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "instructions": ["AGENTS.md"]
}
