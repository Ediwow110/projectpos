generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  passwordHash      String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       BusinessMembership[]
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestId String
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

model Business {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("PHP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships BusinessMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  settings    Setting[]
  categories  Category[]
  products    Product[]
  movements   InventoryMovement[]
  balances    InventoryBalance[]
  sales       Sale[]
  payments    Payment[]
  heldSales   HeldSale[]
  idempotencyKeys SaleIdempotency[]
}

model BusinessMembership {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  roleId     String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model Role {
  id          String               @id @default(cuid())
  businessId  String
  name        String
  permissions RolePermission[]
  memberships BusinessMembership[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  businessId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  business   Business  @relation(fields: [businessId], references: [id])
  @@index([businessId])
  @@index([userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  businessId     String
  actorId        String
  action         String
  entityType     String
  entityId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  reason         String?
  requestId      String
  ip             String?
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id])
  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
}

model Setting {
  id         String   @id @default(cuid())
  businessId String
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, key])
  @@index([businessId])
}

model Category {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id])
  products    Product[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id             String    @id @default(cuid())
  businessId     String
  categoryId     String?
  name           String
  sku            String?
  barcode        String?
  brand          String?
  unit           String    @default("pc")
  costMinor      Int       @default(0)
  priceMinor     Int
  taxRateBps     Int?
  reorderLevel   Int       @default(0)
  trackInventory Boolean   @default(true)
  isActive       Boolean   @default(true)
  imageUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  business       Business  @relation(fields: [businessId], references: [id])
  category       Category? @relation(fields: [categoryId], references: [id])
  preventOversell Boolean   @default(true)
  movements      InventoryMovement[]
  balances       InventoryBalance[]
  @@index([businessId, isActive])
  @@index([businessId, categoryId])
}

model InventoryMovement {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  type          String
  qtyDelta      Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorId       String
  requestId     String
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  @@index([businessId, productId, createdAt])
}

model InventoryBalance {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  qtyOnHand  Int      @default(0)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  @@unique([businessId, productId])
}

model Sale {
  id             String     @id @default(cuid())
  businessId     String
  receiptNo      String
  status         String     @default("DRAFT")
  subtotalMinor  Int        @default(0)
  discountMinor  Int        @default(0)
  taxMinor       Int        @default(0)
  totalMinor     Int        @default(0)
  paidMinor      Int        @default(0)
  changeMinor    Int        @default(0)
  currency       String     @default("PHP")
  customerId     String?
  customerName   String?
  notes          String?
  actorId        String
  requestId      String
  idempotencyKey String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  business       Business   @relation(fields: [businessId], references: [id])
  items          SaleItem[]
  payments       Payment[]
  @@unique([businessId, receiptNo])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, createdAt])
}

model SaleItem {
  id                String @id @default(cuid())
  businessId        String
  saleId            String
  productId         String
  name              String
  unit              String @default("pc")
  qty               Int
  priceMinor        Int
  costMinor         Int    @default(0)
  taxRateBps        Int?
  lineDiscountMinor Int    @default(0)
  lineTotalMinor    Int
  sale              Sale   @relation(fields: [saleId], references: [id])
  @@index([businessId, saleId])
}

model Payment {
  id             String   @id @default(cuid())
  businessId     String
  saleId         String
  method         String
  amountMinor    Int
  status         String   @default("SUCCEEDED")
  providerRef    String?
  idempotencyKey String
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id])
  sale           Sale     @relation(fields: [saleId], references: [id])
  @@unique([businessId, idempotencyKey])
  @@unique([businessId, providerRef])
  @@index([businessId, saleId])
}

model HeldSale {
  id         String    @id @default(cuid())
  businessId String
  actorId    String
  payload    Json
  createdAt  DateTime  @default(now())
  resumedAt  DateTime?
  business   Business  @relation(fields: [businessId], references: [id])
  @@index([businessId, actorId])
}

model SaleIdempotency {
  id          String   @id @default(cuid())
  businessId  String
  key         String
  commandType String
  fingerprint String
  resultId    String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, key, commandType])
}
