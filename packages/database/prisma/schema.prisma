generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  passwordHash      String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       BusinessMembership[]
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestId String
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

model Business {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("PHP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships BusinessMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  settings    Setting[]
  categories  Category[]
  products    Product[]
  movements   InventoryMovement[]
  balances    InventoryBalance[]
  sales       Sale[]
  payments    Payment[]
  heldSales   HeldSale[]
  idempotencyKeys SaleIdempotency[]
  registers   Register[]
  shifts      Shift[]
  cashMovements CashMovement[]
  customers   Customer[]
  refunds     Refund[]
  refundItems RefundItem[]
  expenses    Expense[]
}

model BusinessMembership {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  roleId     String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model Role {
  id          String               @id @default(cuid())
  businessId  String
  name        String
  permissions RolePermission[]
  memberships BusinessMembership[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  businessId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  business   Business  @relation(fields: [businessId], references: [id])
  @@index([businessId])
  @@index([userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  businessId     String
  actorId        String
  action         String
  entityType     String
  entityId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  reason         String?
  requestId      String
  ip             String?
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id])
  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
}

model Setting {
  id         String   @id @default(cuid())
  businessId String
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, key])
  @@index([businessId])
}

model Category {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id])
  products    Product[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id             String    @id @default(cuid())
  businessId     String
  categoryId     String?
  name           String
  sku            String?
  barcode        String?
  brand          String?
  unit           String    @default("pc")
  costMinor      Int       @default(0)
  priceMinor     Int
  taxRateBps     Int?
  reorderLevel   Int       @default(0)
  trackInventory Boolean   @default(true)
  isActive       Boolean   @default(true)
  imageUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  business       Business  @relation(fields: [businessId], references: [id])
  category       Category? @relation(fields: [categoryId], references: [id])
  preventOversell Boolean   @default(true)
  movements      InventoryMovement[]
  balances       InventoryBalance[]
  @@index([businessId, isActive])
  @@index([businessId, categoryId])
}

model InventoryMovement {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  type          String
  qtyDelta      Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorId       String
  requestId     String
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  @@index([businessId, productId, createdAt])
}

model InventoryBalance {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  qtyOnHand  Int      @default(0)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  @@unique([businessId, productId])
}

model Sale {
  id             String     @id @default(cuid())
  businessId     String
  receiptNo      String
  status         String     @default("DRAFT")
  subtotalMinor  Int        @default(0)
  discountMinor  Int        @default(0)
  taxMinor       Int        @default(0)
  totalMinor     Int        @default(0)
  paidMinor      Int        @default(0)
  changeMinor    Int        @default(0)
  currency       String     @default("PHP")
  customerId     String?
  customerName   String?
  notes          String?
  actorId        String
  requestId      String
  idempotencyKey String?
  registerId     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  business       Business   @relation(fields: [businessId], references: [id])
  items          SaleItem[]
  payments       Payment[]
  @@unique([businessId, receiptNo])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, createdAt])
}

model SaleItem {
  id                String @id @default(cuid())
  businessId        String
  saleId            String
  productId         String
  name              String
  unit              String @default("pc")
  qty               Int
  priceMinor        Int
  costMinor         Int    @default(0)
  taxRateBps        Int?
  lineDiscountMinor Int    @default(0)
  lineTotalMinor    Int
  sale              Sale   @relation(fields: [saleId], references: [id])
  @@index([businessId, saleId])
}

model Payment {
  id             String   @id @default(cuid())
  businessId     String
  saleId         String
  method         String
  amountMinor    Int
  status         String   @default("SUCCEEDED")
  providerRef    String?
  idempotencyKey String
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id])
  sale           Sale     @relation(fields: [saleId], references: [id])
  @@unique([businessId, idempotencyKey])
  @@unique([businessId, providerRef])
  @@index([businessId, saleId])
}

model HeldSale {
  id         String    @id @default(cuid())
  businessId String
  actorId    String
  payload    Json
  createdAt  DateTime  @default(now())
  resumedAt  DateTime?
  business   Business  @relation(fields: [businessId], references: [id])
  @@index([businessId, actorId])
}

model SaleIdempotency {
  id          String   @id @default(cuid())
  businessId  String
  key         String
  commandType String
  fingerprint String
  resultId    String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, key, commandType])
}

model Register {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  shifts     Shift[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Shift {
  id                   String    @id @default(cuid())
  businessId           String
  registerId           String
  status               String    @default("OPEN")
  openedBy             String
  closedBy             String?
  openingFloatMinor    Int       @default(0)
  countedCashMinor     Int?
  varianceMinor        Int?
  cashSalesMinor       Int       @default(0)
  cashRefundsMinor     Int       @default(0)
  cashExpensesMinor    Int       @default(0)
  cashDepositsMinor    Int       @default(0)
  cashWithdrawalsMinor Int       @default(0)
  adjustmentsMinor     Int       @default(0)
  expectedCashMinor    Int       @default(0)
  closeNotes           String?
  openedAt             DateTime  @default(now())
  closedAt             DateTime?
  business             Business  @relation(fields: [businessId], references: [id])
  register             Register  @relation(fields: [registerId], references: [id])
  movements            CashMovement[]
  @@index([businessId, registerId, status])
  @@index([businessId, status, openedAt])
}

model CashMovement {
  id            String   @id @default(cuid())
  businessId    String
  shiftId       String
  registerId    String
  type          String
  amountMinor   Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorId       String
  requestId     String
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
  shift         Shift    @relation(fields: [shiftId], references: [id])
  @@index([businessId, shiftId, createdAt])
  @@index([businessId, registerId, createdAt])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, phone])
  @@index([businessId, isActive])
  @@index([businessId, name])
}

model Refund {
  id                String       @id @default(cuid())
  businessId        String
  saleId            String
  status            String       @default("APPROVED")
  totalMinor        Int          @default(0)
  reason            String?
  requestedBy       String
  approvedBy        String
  requestId         String
  approvedRequestId String
  singleStep        Boolean      @default(false)
  createdAt         DateTime     @default(now())
  business          Business     @relation(fields: [businessId], references: [id])
  items             RefundItem[]
  @@index([businessId, saleId])
  @@index([businessId, createdAt])
}

model RefundItem {
  id          String   @id @default(cuid())
  businessId  String
  refundId    String
  saleItemId  String
  productId   String
  qty         Int
  amountMinor Int
  restocked   Boolean  @default(false)
  business    Business @relation(fields: [businessId], references: [id])
  refund      Refund   @relation(fields: [refundId], references: [id])
  @@index([businessId, refundId])
  @@index([businessId, saleItemId])
}

model Expense {
  id            String    @id @default(cuid())
  businessId    String
  category      String
  amountMinor   Int
  description   String?
  method        String
  shiftId       String?
  expenseDate   DateTime  @default(now())
  actorId       String
  requestId     String
  attachmentUrl String?
  voidedAt      DateTime?
  voidReason    String?
  cashAdjusted  Boolean   @default(true)
  createdAt     DateTime  @default(now())
  business      Business  @relation(fields: [businessId], references: [id])
  @@index([businessId, category, expenseDate])
  @@index([businessId, expenseDate])
}
