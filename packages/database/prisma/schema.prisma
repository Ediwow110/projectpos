generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  passwordHash      String
  name              String               @default("")
  // Phase 11: false only when the business opts into email verification;
  // legacy rows and invited members default to verified.
  emailVerified     Boolean              @default(true)
  workspaceTourSeen Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       BusinessMembership[]
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestId String
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

model Business {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("PHP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships BusinessMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  settings    Setting[]
  categories  Category[]
  products    Product[]
  movements   InventoryMovement[]
  balances    InventoryBalance[]
  sales       Sale[]
  payments    Payment[]
  heldSales   HeldSale[]
  idempotencyKeys SaleIdempotency[]
  registers   Register[]
  shifts      Shift[]
  cashMovements CashMovement[]
  customers   Customer[]
  refunds     Refund[]
  refundItems RefundItem[]
  expenses    Expense[]
  branches    Branch[]
  transfers   StockTransfer[]
  transferLines StockTransferLine[]
  devices     Device[]
  subscriptions Subscription[]
  invoices    Invoice[]
  counters    UsageCounter[]
  flags       FeatureFlag[]
  tokens      ApiToken[]
  printers    PrinterDevice[]
  printJobs   PrintJob[]
  displayTokens DisplayToken[]
  corrections ShiftCorrection[]
  receiptShares ReceiptShare[]
  activeSessions Session[] @relation("SessionActiveBusiness")
}

model BusinessMembership {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  roleId     String
  // Phase 12: deactivated members keep the row but lose access.
  deactivatedAt DateTime?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model Role {
  id          String               @id @default(cuid())
  businessId  String
  name        String
  permissions RolePermission[]
  memberships BusinessMembership[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  businessId String
  // Phase 11: explicit active business chosen via POST /auth/active-business;
  // null = home business from login.
  activeBusinessId String?
  // Workspace branch scope; null means "All branches".
  activeBranchId String?
  authenticatedAt DateTime @default(now())
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  // Phase 9b: bound POS device; null = pre-9b sessions and non-device logins.
  deviceId   String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  business   Business  @relation(fields: [businessId], references: [id])
  activeBusiness Business? @relation("SessionActiveBusiness", fields: [activeBusinessId], references: [id], onDelete: SetNull)
  activeBranch Branch? @relation("SessionActiveBranch", fields: [activeBranchId], references: [id], onDelete: SetNull)
  @@index([businessId])
  @@index([userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  // Phase 10: platform-scoped rows (global feature flags) have no tenant.
  businessId     String?
  actorId        String
  action         String
  entityType     String
  entityId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  reason         String?
  requestId      String
  ip             String?
  createdAt      DateTime @default(now())
  business       Business? @relation(fields: [businessId], references: [id])
  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
}

model Setting {
  id         String   @id @default(cuid())
  businessId String
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, key])
  @@index([businessId])
}

model Category {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id])
  products    Product[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id             String    @id @default(cuid())
  businessId     String
  categoryId     String?
  name           String
  sku            String?
  barcode        String?
  brand          String?
  unit           String    @default("pc")
  costMinor      Int       @default(0)
  priceMinor     Int
  taxRateBps     Int?
  reorderLevel   Int       @default(0)
  trackInventory Boolean   @default(true)
  isActive       Boolean   @default(true)
  imageUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  business       Business  @relation(fields: [businessId], references: [id])
  category       Category? @relation(fields: [categoryId], references: [id])
  preventOversell Boolean   @default(true)
  movements      InventoryMovement[]
  balances       InventoryBalance[]
  @@index([businessId, isActive])
  @@index([businessId, categoryId])
}

model InventoryMovement {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  type          String
  qtyDelta      Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorId       String
  requestId     String
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  // Phase 9a: branch scope is a plain nullable string column (no Prisma
  // relation) to minimize relation churn; validated same-business server-side.
  branchId      String?
  @@index([businessId, productId, createdAt])
}

model InventoryBalance {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  qtyOnHand  Int      @default(0)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  // Phase 9a: nullable branch scope; null = legacy head-office scope.
  // Phase 12: the balance key includes branchId (one row per branch scope);
  // migration 0014 makes the unique index NULLS NOT DISTINCT (PG 15+) so the
  // null scope stays unique too — not expressible in the Prisma DSL.
  branchId   String?
  @@unique([businessId, productId, branchId])
}

model Sale {
  id             String     @id @default(cuid())
  businessId     String
  receiptNo      String
  status         String     @default("DRAFT")
  subtotalMinor  Int        @default(0)
  discountMinor  Int        @default(0)
  taxMinor       Int        @default(0)
  totalMinor     Int        @default(0)
  paidMinor      Int        @default(0)
  changeMinor    Int        @default(0)
  currency       String     @default("PHP")
  customerId     String?
  customerName   String?
  notes          String?
  actorId        String
  requestId      String
  idempotencyKey String?
  registerId     String?
  // Phase 9a: nullable branch scope (register's branch, else explicit, else null).
  branchId       String?
  // Phase 12: set when the sale reaches COMPLETED; usage metering buckets by this.
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  business       Business   @relation(fields: [businessId], references: [id])
  items          SaleItem[]
  payments       Payment[]
  @@unique([businessId, receiptNo])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, createdAt])
  @@index([businessId, customerId])
  @@index([businessId, registerId])
}

model SaleItem {
  id                String @id @default(cuid())
  businessId        String
  saleId            String
  position          Int    @default(0)
  productId         String
  name              String
  unit              String @default("pc")
  qty               Int
  priceMinor        Int
  costMinor         Int    @default(0)
  taxRateBps        Int?
  lineDiscountMinor Int    @default(0)
  lineTotalMinor    Int
  sale              Sale   @relation(fields: [saleId], references: [id])
  @@index([businessId, saleId])
  @@index([businessId, saleId, position])
}

model Payment {
  id             String   @id @default(cuid())
  businessId     String
  saleId         String
  method         String
  amountMinor    Int
  status         String   @default("SUCCEEDED")
  providerRef    String?
  idempotencyKey String
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id])
  sale           Sale     @relation(fields: [saleId], references: [id])
  @@unique([businessId, idempotencyKey])
  @@unique([businessId, providerRef])
  @@index([businessId, saleId])
}

model HeldSale {
  id         String    @id @default(cuid())
  businessId String
  actorId    String
  payload    Json
  createdAt  DateTime  @default(now())
  resumedAt  DateTime?
  business   Business  @relation(fields: [businessId], references: [id])
  @@index([businessId, actorId])
}

model SaleIdempotency {
  id          String   @id @default(cuid())
  businessId  String
  key         String
  commandType String
  fingerprint String
  resultId    String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, key, commandType])
}

model Register {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isActive   Boolean  @default(true)
  // Phase 9a: optional home branch.
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  shifts     Shift[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Shift {
  id                   String    @id @default(cuid())
  businessId           String
  registerId           String
  // Phase 9a: copied from register at open.
  branchId             String?
  status               String    @default("OPEN")
  openedBy             String
  closedBy             String?
  openingFloatMinor    Int       @default(0)
  countedCashMinor     Int?
  varianceMinor        Int?
  cashSalesMinor       Int       @default(0)
  cashRefundsMinor     Int       @default(0)
  cashExpensesMinor    Int       @default(0)
  cashDepositsMinor    Int       @default(0)
  cashWithdrawalsMinor Int       @default(0)
  adjustmentsMinor     Int       @default(0)
  expectedCashMinor    Int       @default(0)
  closeNotes           String?
  openedAt             DateTime  @default(now())
  closedAt             DateTime?
  business             Business  @relation(fields: [businessId], references: [id])
  register             Register  @relation(fields: [registerId], references: [id])
  movements            CashMovement[]
  corrections          ShiftCorrection[]
  @@index([businessId, registerId, status])
  @@index([businessId, status, openedAt])
}

model CashMovement {
  id            String   @id @default(cuid())
  businessId    String
  shiftId       String
  registerId    String
  // Phase 9a: copied from shift.
  branchId      String?
  type          String
  amountMinor   Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorId       String
  requestId     String
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
  shift         Shift    @relation(fields: [shiftId], references: [id])
  @@index([businessId, shiftId, createdAt])
  @@index([businessId, registerId, createdAt])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, phone])
  @@index([businessId, isActive])
  @@index([businessId, name])
}

model Refund {
  id                String       @id @default(cuid())
  businessId        String
  saleId            String
  status            String       @default("APPROVED")
  totalMinor        Int          @default(0)
  reason            String?
  requestedBy       String
  approvedBy        String
  requestId         String
  approvedRequestId String
  singleStep        Boolean      @default(false)
  createdAt         DateTime     @default(now())
  business          Business     @relation(fields: [businessId], references: [id])
  items             RefundItem[]
  @@index([businessId, saleId])
  @@index([businessId, createdAt])
}

model RefundItem {
  id          String   @id @default(cuid())
  businessId  String
  refundId    String
  saleItemId  String
  productId   String
  qty         Int
  amountMinor Int
  restocked   Boolean  @default(false)
  business    Business @relation(fields: [businessId], references: [id])
  refund      Refund   @relation(fields: [refundId], references: [id])
  @@index([businessId, refundId])
  @@index([businessId, saleItemId])
}

model Expense {
  id            String    @id @default(cuid())
  businessId    String
  category      String
  amountMinor   Int
  description   String?
  method        String
  shiftId       String?
  // Phase 9a: shift's branch when shift-linked, else explicit input, else null.
  branchId      String?
  expenseDate   DateTime  @default(now())
  actorId       String
  requestId     String
  attachmentUrl String?
  voidedAt      DateTime?
  voidReason    String?
  cashAdjusted  Boolean   @default(true)
  createdAt     DateTime  @default(now())
  business      Business  @relation(fields: [businessId], references: [id])
  @@index([businessId, category, expenseDate])
  @@index([businessId, expenseDate])
}

model Branch {
  id         String     @id @default(cuid())
  businessId String
  name       String
  type       String     @default("store")
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  business   Business   @relation(fields: [businessId], references: [id])
  registers  Register[]
  activeSessions Session[] @relation("SessionActiveBranch")
  @@unique([businessId, name])
  @@index([businessId])
}

model StockTransfer {
  id           String              @id @default(cuid())
  businessId   String
  fromBranchId String
  toBranchId   String
  status       String              @default("DRAFT")
  requestedBy  String
  dispatchedBy String?
  receivedBy   String?
  requestId    String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  business     Business            @relation(fields: [businessId], references: [id])
  lines        StockTransferLine[]
  @@index([businessId, status, createdAt])
}

model StockTransferLine {
  id         String        @id @default(cuid())
  businessId String
  transferId String
  productId  String
  qty        Int
  business   Business      @relation(fields: [businessId], references: [id])
  transfer   StockTransfer @relation(fields: [transferId], references: [id])
  @@index([businessId, transferId])
}

model Device {
  id         String    @id @default(cuid())
  businessId String
  userId     String
  label      String
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id])
  @@index([businessId, userId])
}

model Plan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  allowances  Json
  pricesMinor Json
  isActive    Boolean  @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id               String    @id @default(cuid())
  businessId       String    @unique
  planId           String
  status           String    @default("trialing")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime
  providerRef      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  business         Business  @relation(fields: [businessId], references: [id])
  plan             Plan      @relation(fields: [planId], references: [id])
  invoices         Invoice[]
}

model Invoice {
  id             String    @id @default(cuid())
  businessId     String
  subscriptionId String
  periodStart    DateTime
  periodEnd      DateTime
  amountMinor    Int
  currency       String    @default("PHP")
  status         String    @default("open")
  issuedAt       DateTime  @default(now())
  paidAt         DateTime?
  business       Business     @relation(fields: [businessId], references: [id])
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  @@index([businessId, issuedAt])
}

model UsageCounter {
  id         String   @id @default(cuid())
  businessId String
  key        String
  period     String
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, key, period])
}

model FeatureFlag {
  id         String   @id @default(cuid())
  businessId String?
  key        String
  enabled    Boolean
  business   Business? @relation(fields: [businessId], references: [id])
  @@index([businessId, key])
}

model BillingWebhookEvent {
  id         String   @id @default(cuid())
  businessId String?
  provider   String
  eventId    String   @unique
  type       String
  payload    Json
  status     String   @default("applied")
  receivedAt DateTime @default(now())
}

model ApiToken {
  id         String    @id @default(cuid())
  businessId String
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     Json
  revokedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id])
  @@index([businessId])
}

model PrinterDevice {
  id             String   @id @default(cuid())
  businessId     String
  branchId       String?
  name           String
  width          String   @default("80")
  connection     String   @default("test-double")
  agentTokenHash String?  @unique
  business       Business  @relation(fields: [businessId], references: [id])
  jobs           PrintJob[]
}

model PrintJob {
  id         String   @id @default(cuid())
  businessId String
  printerId  String
  receiptNo  String?
  layout     String   @default("80")
  status     String   @default("QUEUED")
  payload    String
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  business   Business      @relation(fields: [businessId], references: [id])
  printer    PrinterDevice @relation(fields: [printerId], references: [id])
  @@index([businessId, status])
  @@index([printerId, createdAt])
}

model DisplayToken {
  id         String   @id @default(cuid())
  businessId String
  registerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id])
  @@index([businessId, registerId])
}

model PlatformSupportGrant {
  id        String    @id @default(cuid())
  purpose   String
  actorId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ManagerApprovalGrant {
  id          String    @id @default(cuid())
  businessId  String
  requesterId String
  approverId  String
  permission  String
  fingerprint String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId, requesterId, permission])
  @@index([expiresAt])
}

model ShiftCorrection {
  id          String   @id @default(cuid())
  businessId  String
  shiftId     String
  amountMinor Int
  reason      String
  actorId     String
  requestId   String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  shift       Shift    @relation(fields: [shiftId], references: [id])

  @@index([businessId, shiftId])
}

model ReceiptShare {
  id         String   @id @default(cuid())
  businessId String
  saleId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, saleId])
}

model ReceiptCounter {
  id         String   @id @default(cuid())
  businessId String   @unique
  seq        Int
  business   Business @relation(fields: [businessId], references: [id])
}

model RateLimitHit {
  id  String   @id @default(cuid())
  key String
  at  DateTime

  @@index([key, at])
}
