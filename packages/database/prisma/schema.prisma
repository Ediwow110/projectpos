generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  passwordHash      String
  name              String               @default("")
  // Phase 11: false only when the business opts into email verification;
  // legacy rows and invited members default to verified.
  emailVerified     Boolean              @default(true)
  workspaceTourSeen Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       BusinessMembership[]
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestId String
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

model Business {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("PHP")
  storefrontKey String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships BusinessMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  settings    Setting[]
  categories  Category[]
  products    Product[]
  productFamilies ProductFamily[]
  productOptions ProductOption[]
  productOptionValues ProductOptionValue[]
  productVariantOptionValues ProductVariantOptionValue[]
  productBundles ProductBundle[]
  bundleComponents BundleComponent[]
  saleItemBundleComponents SaleItemBundleComponent[]
  movements   InventoryMovement[]
  balances    InventoryBalance[]
  inventoryCounts InventoryCount[]
  inventoryCountLines InventoryCountLine[]
  inventoryCountCounters InventoryCountCounter[]
  sales       Sale[]
  payments    Payment[]
  heldSales   HeldSale[]
  idempotencyKeys SaleIdempotency[]
  registers   Register[]
  shifts      Shift[]
  cashMovements CashMovement[]
  customers   Customer[]
  refunds     Refund[]
  customerConcerns CustomerConcern[]
  refundItems RefundItem[]
  expenses    Expense[]
  branches    Branch[]
  transfers   StockTransfer[]
  transferLines StockTransferLine[]
  devices     Device[]
  subscriptions Subscription[]
  invoices    Invoice[]
  counters    UsageCounter[]
  flags       FeatureFlag[]
  tokens      ApiToken[]
  printers    PrinterDevice[]
  printJobs   PrintJob[]
  displayTokens DisplayToken[]
  corrections ShiftCorrection[]
  receiptShares ReceiptShare[]
  receiptDeliveries ReceiptDelivery[]
  receiptCounters ReceiptCounter[]
  suppliers Supplier[]
  productSuppliers ProductSupplier[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  poCounters POCounter[]
  purchaseReceipts PurchaseReceipt[]
  purchaseReceiptLines PurchaseReceiptLine[]
  supplierReturns SupplierReturn[]
  supplierReturnLines SupplierReturnLine[]
  purchaseReceiptCounters PurchaseReceiptCounter[]
  supplierReturnCounters SupplierReturnCounter[]
  giftCards GiftCard[]
  giftCardTransactions GiftCardTransaction[]
  storeCreditAccounts StoreCreditAccount[]
  storeCreditTransactions StoreCreditTransaction[]
  loyaltyPrograms LoyaltyProgram[]
  loyaltyAccounts LoyaltyAccount[]
  loyaltyTransactions LoyaltyTransaction[]
  saleGiftCardLoads SaleGiftCardLoad[]
  saleLoyaltySnapshots SaleLoyalty[]
  saleItemLoyaltyAllocations SaleItemLoyaltyAllocation[]
  orders Order[]
  orderLines OrderLine[]
  inventoryReservations InventoryReservation[]
  fulfillments Fulfillment[]
  fulfillmentLines FulfillmentLine[]
  orderAccessTokens OrderAccessToken[]
  orderNotificationOutbox OrderNotificationOutbox[]
  activeSessions Session[] @relation("SessionActiveBusiness")
}

model BusinessMembership {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  roleId     String
  // Phase 12: deactivated members keep the row but lose access.
  deactivatedAt DateTime?
  approvalPinHash String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model Role {
  id          String               @id @default(cuid())
  businessId  String
  name        String
  permissions RolePermission[]
  memberships BusinessMembership[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  businessId String
  // Phase 11: explicit active business chosen via POST /auth/active-business;
  // null = home business from login.
  activeBusinessId String?
  // Workspace branch scope; null means "All branches".
  activeBranchId String?
  authenticatedAt DateTime @default(now())
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  // Phase 9b: bound POS device; null = pre-9b sessions and non-device logins.
  deviceId   String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  business   Business  @relation(fields: [businessId], references: [id])
  activeBusiness Business? @relation("SessionActiveBusiness", fields: [activeBusinessId], references: [id], onDelete: SetNull)
  activeBranch Branch? @relation("SessionActiveBranch", fields: [activeBranchId], references: [id], onDelete: SetNull)
  @@index([businessId])
  @@index([userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  // Phase 10: platform-scoped rows (global feature flags) have no tenant.
  businessId     String?
  actorId        String
  action         String
  entityType     String
  entityId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  reason         String?
  requestId      String
  ip             String?
  createdAt      DateTime @default(now())
  business       Business? @relation(fields: [businessId], references: [id])
  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
}

model Setting {
  id         String   @id @default(cuid())
  businessId String
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, key])
  @@index([businessId])
}

model Category {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id])
  products    Product[]
  productFamilies ProductFamily[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id             String    @id @default(cuid())
  businessId     String
  familyId       String?
  productType    String    @default("STANDARD")
  categoryId     String?
  name           String
  sku            String?
  barcode        String?
  brand          String?
  unit           String    @default("pc")
  costMinor      Int       @default(0)
  priceMinor     Int
  taxRateBps     Int?
  reorderLevel   Int       @default(0)
  trackInventory Boolean   @default(true)
  isActive       Boolean   @default(true)
  imageUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  business       Business  @relation(fields: [businessId], references: [id])
  family         ProductFamily? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  category       Category? @relation(fields: [categoryId], references: [id])
  preventOversell Boolean   @default(true)
  movements      InventoryMovement[]
  balances       InventoryBalance[]
  productSuppliers ProductSupplier[]
  purchaseOrderLines PurchaseOrderLine[]
  purchaseReceiptLines PurchaseReceiptLine[]
  supplierReturnLines SupplierReturnLine[]
  inventoryCountLines InventoryCountLine[]
  variantOptionValues ProductVariantOptionValue[]
  bundle             ProductBundle? @relation("BundleProduct")
  bundleComponents   BundleComponent[] @relation("BundleComponentProduct")
  stockExceptions    StockException[]
  @@unique([businessId, id])
  @@index([businessId, isActive])
  @@index([businessId, categoryId])
  @@index([businessId, familyId, isActive])
}

model ProductFamily {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  categoryId  String?
  brand       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
  products    Product[]
  options     ProductOption[]
  @@unique([businessId, name])
  @@index([businessId, isActive])
}

model ProductOption {
  id         String   @id @default(cuid())
  businessId String
  familyId   String
  name       String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  family     ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  values     ProductOptionValue[]
  links      ProductVariantOptionValue[]
  @@unique([businessId, familyId, name])
  @@unique([businessId, familyId, position])
  @@index([businessId, familyId])
}

model ProductOptionValue {
  id         String   @id @default(cuid())
  businessId String
  optionId   String
  value      String
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  option     ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  links      ProductVariantOptionValue[]
  @@unique([businessId, optionId, value])
  @@unique([businessId, optionId, position])
  @@index([businessId, optionId])
}

model ProductVariantOptionValue {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  optionId      String
  optionValueId String
  createdAt     DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id])
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  option       ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionValue  ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  @@unique([businessId, productId, optionId])
  @@unique([businessId, productId, optionValueId])
  @@index([businessId, optionId, optionValueId])
}

model ProductBundle {
  id             String   @id @default(cuid())
  businessId     String
  bundleProductId String  @unique
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id])
  bundleProduct  Product @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  components     BundleComponent[]
  snapshots      SaleItemBundleComponent[]
  @@index([businessId])
}

model BundleComponent {
  id            String   @id @default(cuid())
  businessId    String
  bundleId      String
  componentProductId String
  quantity      Int
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id])
  bundle        ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  componentProduct Product @relation("BundleComponentProduct", fields: [componentProductId], references: [id])
  @@unique([businessId, bundleId, componentProductId])
  @@index([businessId, bundleId, position])
}

model InventoryMovement {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  type          String
  qtyDelta      Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorId       String
  requestId     String
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  // Phase 9a: branch scope is a plain nullable string column (no Prisma
  // relation) to minimize relation churn; validated same-business server-side.
  branchId      String?
  @@index([businessId, productId, createdAt])
}

/// Phase C: a reported damage/expiration risk. Reporting does not alter
/// saleable stock; a separately audited disposition writes a stock movement.
model StockException {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  branchId   String?
  kind       String
  quantity   Int
  expiresOn  String?
  reason     String
  status     String   @default("OPEN")
  reportKey  String
  reportedBy String
  createdAt  DateTime @default(now())
  disposedBy String?
  disposedAt DateTime?
  movementId String?
  product    Product @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict, map: "StockException_tenant_product_fkey")
  branch     Branch? @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict, map: "StockException_tenant_branch_fkey")
  @@unique([businessId, reportKey])
  @@index([businessId, branchId, status, createdAt])
  @@index([businessId, productId])
}

model GuestSupportCase {
  id             String   @id @default(cuid())
  businessId     String
  orderId        String
  category       String
  description    String
  status         String   @default("OPEN")
  idempotencyKey String
  createdAt      DateTime @default(now())
  closedAt       DateTime?
  closedBy       String?
  order          Order @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Restrict, map: "GuestSupportCase_tenant_order_fkey")
  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, createdAt])
  @@index([businessId, orderId, createdAt])
}

model PlatformOwnerConsent {
  id        String   @id @default(cuid())
  businessId String
  ownerId   String
  purpose   String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  @@index([businessId, expiresAt])
}

model InventoryBalance {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  qtyOnHand  Int      @default(0)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  // Phase 9a: nullable branch scope; null = legacy head-office scope.
  // Phase 12: the balance key includes branchId (one row per branch scope);
  // migration 0014 makes the unique index NULLS NOT DISTINCT (PG 15+) so the
  // null scope stays unique too — not expressible in the Prisma DSL.
  branchId   String?
  @@unique([businessId, productId, branchId])
}

model InventoryCountCounter {
  id         String   @id @default(cuid())
  businessId String   @unique
  seq        Int
  business   Business @relation(fields: [businessId], references: [id])
}

model InventoryCount {
  id                  String   @id @default(cuid())
  businessId          String
  branchId            String?
  countNumber         String
  status              String   @default("DRAFT")
  scopeType           String
  name                String
  notes               String?
  createdBy           String
  startedAt           DateTime?
  submittedBy         String?
  submittedAt         DateTime?
  approvedBy          String?
  approvedAt          DateTime?
  approvalFingerprint String?
  postedBy            String?
  postedAt            DateTime?
  cancelledBy         String?
  cancelledAt         DateTime?
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  business            Business @relation(fields: [businessId], references: [id])
  branch              Branch?  @relation(fields: [branchId], references: [id])
  lines               InventoryCountLine[]
  @@unique([businessId, countNumber])
  @@index([businessId, status, createdAt])
  @@index([businessId, branchId, status])
}

model InventoryCountLine {
  id                     String   @id @default(cuid())
  businessId             String
  inventoryCountId       String
  productId              String
  expectedQtySnapshot    Int
  balanceUpdatedAtSnapshot DateTime?
  countedQty             Int?
  varianceQty            Int?
  productNameSnapshot    String
  skuSnapshot            String?
  notes                  String?
  countedBy              String?
  countedAt              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  business               Business       @relation(fields: [businessId], references: [id])
  inventoryCount         InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product                Product        @relation(fields: [productId], references: [id])
  @@unique([businessId, inventoryCountId, productId])
  @@index([businessId, inventoryCountId])
}

model Sale {
  id             String     @id @default(cuid())
  businessId     String
  receiptNo      String
  status         String     @default("DRAFT")
  subtotalMinor  Int        @default(0)
  discountMinor  Int        @default(0)
  taxMinor       Int        @default(0)
  deliveryFeeMinor Int      @default(0)
  deliveryTaxMinor Int      @default(0)
  totalMinor     Int        @default(0)
  paidMinor      Int        @default(0)
  changeMinor    Int        @default(0)
  currency       String     @default("PHP")
  customerId     String?
  customerName   String?
  notes          String?
  actorId        String
  requestId      String
  idempotencyKey String?
  registerId     String?
  // Phase 9a: nullable branch scope (register's branch, else explicit, else null).
  branchId       String?
  // Phase 12: set when the sale reaches COMPLETED; usage metering buckets by this.
  completedAt    DateTime?
  // Phase 21: retained explanation and timestamp for an audited void.
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  business       Business   @relation(fields: [businessId], references: [id])
  items          SaleItem[]
  customerConcerns CustomerConcern[]
  payments       Payment[]
  receiptDeliveries ReceiptDelivery[]
  giftCardLoads  SaleGiftCardLoad[]
  loyaltySnapshot SaleLoyalty?
  @@unique([businessId, receiptNo])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, createdAt])
  @@index([businessId, customerId])
  @@index([businessId, registerId])
}

model SaleItem {
  id                String @id @default(cuid())
  businessId        String
  saleId            String
  position          Int    @default(0)
  productId         String
  name              String
  unit              String @default("pc")
  qty               Int
  priceMinor        Int
  costMinor         Int    @default(0)
  taxRateBps        Int?
  lineDiscountMinor Int    @default(0)
  lineTotalMinor    Int
  sale              Sale   @relation(fields: [saleId], references: [id])
  bundleSnapshots   SaleItemBundleComponent[]
  @@index([businessId, saleId])
  @@index([businessId, saleId, position])
}

model SaleItemBundleComponent {
  id                         String   @id @default(cuid())
  businessId                 String
  saleItemId                 String
  bundleId                   String
  componentProductId         String
  componentNameSnapshot      String
  quantityPerBundleSnapshot  Int
  costMinorSnapshot          Int
  compositionVersion         Int
  createdAt                  DateTime @default(now())
  business                   Business @relation(fields: [businessId], references: [id])
  saleItem                   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  bundle                     ProductBundle @relation(fields: [bundleId], references: [id])
  @@index([businessId, saleItemId])
  @@index([businessId, bundleId])
}

model Payment {
  id             String   @id @default(cuid())
  businessId     String
  saleId         String
  method         String
  amountMinor    Int
  status         String   @default("SUCCEEDED")
  providerRef    String?
  internalInstrumentType String?
  internalInstrumentId   String?
  idempotencyKey String
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id])
  sale           Sale     @relation(fields: [saleId], references: [id])
  @@unique([businessId, idempotencyKey])
  @@unique([businessId, providerRef])
  @@index([businessId, saleId])
  @@index([businessId, internalInstrumentType, internalInstrumentId])
}

model HeldSale {
  id         String    @id @default(cuid())
  businessId String
  actorId    String
  payload    Json
  createdAt  DateTime  @default(now())
  resumedAt  DateTime?
  business   Business  @relation(fields: [businessId], references: [id])
  @@index([businessId, actorId])
}

model SaleIdempotency {
  id          String   @id @default(cuid())
  businessId  String
  key         String
  commandType String
  fingerprint String
  resultId    String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, key, commandType])
}

model Register {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isActive   Boolean  @default(true)
  // Phase 9a: optional home branch.
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  shifts     Shift[]
  @@unique([businessId, name])
  @@index([businessId])
}

model Shift {
  id                   String    @id @default(cuid())
  businessId           String
  registerId           String
  // Phase 9a: copied from register at open.
  branchId             String?
  status               String    @default("OPEN")
  openedBy             String
  closedBy             String?
  openingFloatMinor    Int       @default(0)
  countedCashMinor     Int?
  varianceMinor        Int?
  cashSalesMinor       Int       @default(0)
  cashRefundsMinor     Int       @default(0)
  cashExpensesMinor    Int       @default(0)
  cashDepositsMinor    Int       @default(0)
  cashWithdrawalsMinor Int       @default(0)
  adjustmentsMinor     Int       @default(0)
  expectedCashMinor    Int       @default(0)
  closeNotes           String?
  openedAt             DateTime  @default(now())
  closedAt             DateTime?
  business             Business  @relation(fields: [businessId], references: [id])
  register             Register  @relation(fields: [registerId], references: [id])
  movements            CashMovement[]
  corrections          ShiftCorrection[]
  @@index([businessId, registerId, status])
  @@index([businessId, status, openedAt])
}

model CashMovement {
  id            String   @id @default(cuid())
  businessId    String
  shiftId       String
  registerId    String
  // Phase 9a: copied from shift.
  branchId      String?
  type          String
  amountMinor   Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorId       String
  requestId     String
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
  shift         Shift    @relation(fields: [shiftId], references: [id])
  @@index([businessId, shiftId, createdAt])
  @@index([businessId, registerId, createdAt])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  storeCreditAccounts StoreCreditAccount[]
  loyaltyAccounts LoyaltyAccount[]
  @@unique([businessId, phone])
  @@index([businessId, isActive])
  @@index([businessId, name])
}

model Refund {
  id                String       @id @default(cuid())
  businessId        String
  saleId            String
  status            String       @default("APPROVED")
  totalMinor        Int          @default(0)
  deliveryFeeRefundMinor Int     @default(0)
  deliveryTaxRefundMinor Int     @default(0)
  reason            String?
  requestedBy       String
  approvedBy        String
  requestId         String
  approvedRequestId String
  singleStep        Boolean      @default(false)
  createdAt         DateTime     @default(now())
  business          Business     @relation(fields: [businessId], references: [id])
  items             RefundItem[]
  @@index([businessId, saleId])
  @@index([businessId, createdAt])
}

model CustomerConcern {
  id                   String   @id
  businessId           String
  saleId               String
  receiptNo            String
  branchId             String?
  registerId           String?
  requesterId          String
  reason               String
  outcome              String
  note                 String?
  items                Json
  requestedRefundMinor Int
  status               String
  idempotencyKey       String
  reviewedBy           String?
  reviewedAt           DateTime?
  reviewReason         String?
  refundId             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
