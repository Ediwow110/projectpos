node_modules/
.next/
# `next build` and the Playwright webServer both write into apps/web/.next; a
# run that needs to preserve the previous build moves it aside instead. Those
# moved-aside trees are build output, never sources.
.next-*/
dist/
build/
.turbo/
.env
.env.local
.env.*.local
*.log
coverage/
.worktrees/
worktrees/
.superpowers/
*.tsbuildinfo
# Playwright artifacts.
test-results/
test-results-*/
playwright-report/
.playwright-mcp/
# scripts/run-e2e.mjs takes a repo-root lock while a run is active and removes
# it on every exit path. It is a transient runner artifact, never a source file.
.e2e-run.lock

# Local AI/tool state and one-off audit probes.
.freebuff/
.workbuddy-ai/
.tmp-*.mjs
.prod-*-smoke.mjs
apps/api/tsconfig.deep-audit-check.json
